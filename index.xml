<?xml version="1.0" encoding="utf-8"?>
<skin>
	<information>
		<name>ColdBrewony</name>
		<version>4.0.0</version>
		<description>
			<![CDATA[
				Brewed slowly, shipped daily. 백엔드 개발 기록을 위한 티스토리 반응형 스킨. 오트밀크 라이트 · 에스프레소 다크 테마, 목차, 읽는 시간, 진행 막대 지원 — ColdBrewony
			]]>
		</description>
		<license>
			<![CDATA[
				ColdBrewony — https://github.com/ColdBrewony
			]]>
		</license>
	</information>
	<author>
		<name>ColdBrewony</name>
		<homepage>https://github.com/ColdBrewony</homepage>
		<email></email>
	</author>
	<default>
		<entriesOnPage>10</entriesOnPage>
		<entriesOnList>12</entriesOnList>
		<recentEntries>5</recentEntries>
		<recentComments>5</recentComments>
		<itemsOnGuestbook>10</itemsOnGuestbook>
		<tagsInCloud>24</tagsInCloud>
		<sortInCloud>3</sortInCloud>
		<expandComment>1</expandComment>
		<lengthOfRecentNotice>40</lengthOfRecentNotice>
		<lengthOfRecentEntry>40</lengthOfRecentEntry>
		<lengthOfRecentComment>40</lengthOfRecentComment>
		<lengthOfLink>30</lengthOfLink>
		<showListOnCategory>1</showListOnCategory>
		<showListOnArchive>1</showListOnArchive>
		<commentMessage>
			<none>0</none>
			<single>1</single>
		</commentMessage>
		<contentWidth>720</contentWidth>
	</default>
	<cover>
		<item>
			<name>cb-cover-featured</name>
			<label><![CDATA[추천 카드 (큰 글 1 + 작은 글)]]></label>
			<description><![CDATA[썸네일 카드 그리드. 첫 글이 크게 표시됩니다.]]></description>
		</item>
		<item>
			<name>cb-cover-list</name>
			<label><![CDATA[순위 목록]]></label>
			<description><![CDATA[번호가 붙은 제목 목록.]]></description>
		</item>
	</cover>
	<liststyle>
		<item>
			<label>기본 목록</label>
			<value>cb-list-default</value>
		</item>
	</liststyle>
	<variables>
		<variablegroup name="테마">
			<variable>
				<name>cb-default-theme</name>
				<label><![CDATA[기본 테마]]></label>
				<description><![CDATA[방문자가 직접 바꾸면 그 선택이 우선합니다.]]></description>
				<type>SELECT</type>
				<option>
					<![CDATA[
						[
							{"name":"cb-theme-auto","label":"기기 설정 따르기","value":"cb-theme-auto"},
							{"name":"cb-theme-light","label":"오트밀크 (밝게)","value":"cb-theme-light"},
							{"name":"cb-theme-dark","label":"에스프레소 (어둡게)","value":"cb-theme-dark"}
						]
					]]>
				</option>
				<default>cb-theme-auto</default>
			</variable>
			<variable>
				<name>cb-accent</name>
				<label><![CDATA[강조 색]]></label>
				<description></description>
				<type>SELECT</type>
				<option>
					<![CDATA[
						[
							{"name":"cb-accent-copper","label":"캐러멜 (기본)","value":"cb-accent-copper"},
							{"name":"cb-accent-ice","label":"아이스 블루","value":"cb-accent-ice"},
							{"name":"cb-accent-matcha","label":"말차","value":"cb-accent-matcha"},
							{"name":"cb-accent-cherry","label":"커피 체리","value":"cb-accent-cherry"}
						]
					]]>
				</option>
				<default>cb-accent-copper</default>
			</variable>
		</variablegroup>
		<variablegroup name="상단 · 홈">
			<variable>
				<name>cb-logo-use</name>
				<label><![CDATA[블로그 제목 대신 로고 이미지 사용]]></label>
				<description></description>
				<type>BOOL</type>
				<option />
				<default>false</default>
			</variable>
			<variable>
				<name>cb-logo</name>
				<label><![CDATA[로고 이미지]]></label>
				<description><![CDATA[높이 34px 로 표시됩니다.]]></description>
				<type>IMAGE</type>
				<option />
				<default></default>
			</variable>
			<variable>
				<name>cb-hero-show</name>
				<label><![CDATA[홈 첫 화면에 블로그 소개 표시]]></label>
				<description></description>
				<type>BOOL</type>
				<option />
				<default>true</default>
			</variable>
			<variable>
				<name>cb-hero-eyebrow</name>
				<label><![CDATA[소개 위 작은 문구]]></label>
				<description></description>
				<type>STRING</type>
				<option />
				<default>Backend Developer · Brewed slowly, shipped daily.</default>
			</variable>
		</variablegroup>
		<variablegroup name="레이아웃">
			<variable>
				<name>cb-sidebar-show</name>
				<label><![CDATA[사이드바 표시]]></label>
				<description><![CDATA[끄면 한 칼럼으로 가운데 정렬됩니다.]]></description>
				<type>BOOL</type>
				<option />
				<default>true</default>
			</variable>
		</variablegroup>
		<variablegroup name="글">
			<variable>
				<name>cb-show-author</name>
				<label><![CDATA[작성자 표시]]></label>
				<description></description>
				<type>BOOL</type>
				<option />
				<default>false</default>
			</variable>
			<variable>
				<name>cb-toc</name>
				<label><![CDATA[목차 자동 생성 (소제목 3개 이상)]]></label>
				<description></description>
				<type>BOOL</type>
				<option />
				<default>true</default>
			</variable>
			<variable>
				<name>cb-reading-time</name>
				<label><![CDATA[읽는 시간 표시]]></label>
				<description></description>
				<type>BOOL</type>
				<option />
				<default>true</default>
			</variable>
			<variable>
				<name>cb-show-related</name>
				<label><![CDATA[같은 카테고리의 다른 글 표시]]></label>
				<description></description>
				<type>BOOL</type>
				<option />
				<default>true</default>
			</variable>
			<variable>
				<name>cb-new-comment</name>
				<label><![CDATA[티스토리 새 댓글 시스템 사용]]></label>
				<description><![CDATA[끄면 스킨 자체 댓글 디자인을 씁니다.]]></description>
				<type>BOOL</type>
				<option />
				<default>true</default>
			</variable>
			<variable>
				<name>cb-new-guestbook</name>
				<label><![CDATA[티스토리 새 방명록 시스템 사용]]></label>
				<description></description>
				<type>BOOL</type>
				<option />
				<default>true</default>
			</variable>
		</variablegroup>
		<variablegroup name="소셜 · 푸터">
			<variable>
				<name>cb-github-url</name>
				<label><![CDATA[GitHub 주소]]></label>
				<description></description>
				<type>STRING</type>
				<option />
				<default>https://github.com/ColdBrewony</default>
			</variable>
			<variable>
				<name>cb-portfolio-url</name>
				<label><![CDATA[포트폴리오 주소]]></label>
				<description></description>
				<type>STRING</type>
				<option />
				<default>https://portfolio-woonny-s-projects.vercel.app/</default>
			</variable>
			<variable>
				<name>cb-instagram-url</name>
				<label><![CDATA[Instagram 주소]]></label>
				<description></description>
				<type>STRING</type>
				<option />
				<default></default>
			</variable>
			<variable>
				<name>cb-x-url</name>
				<label><![CDATA[X 주소]]></label>
				<description></description>
				<type>STRING</type>
				<option />
				<default></default>
			</variable>
			<variable>
				<name>cb-youtube-url</name>
				<label><![CDATA[YouTube 주소]]></label>
				<description></description>
				<type>STRING</type>
				<option />
				<default></default>
			</variable>
			<variable>
				<name>cb-footer-text</name>
				<label><![CDATA[푸터 한 줄 소개]]></label>
				<description></description>
				<type>STRING</type>
				<option />
				<default>천천히, 그러나 꾸준히 커밋합니다.</default>
			</variable>
		</variablegroup>
	</variables>
</skin>
